\begin{luacode}
  init_elements()
  local r = 4
  z.A = point:polar_deg(r, 120)
  z.B = point:polar_deg(r, 210)
  z.C = point:polar_deg(r, 330)
  T.ABC = triangle(z.A, z.B, z.C)

  z.H = T.ABC.orthocenter
  _, z.D, z.E = T.ABC:orthic():get()
  C.BHC = triangle(z.B, z.H, z.C):circum_circle()
  z.P = C.BHC:point(0.15, z.C)
  _, z.Q, z.R = T.ABC:cevian(z.P):get()

  z.w = C.BHC.center

  z.M = T.ABC.bc.mid
  z.X = intersection(C.BHC, line(z.A, z.M), {near = z.A})
  z.N = intersection(line(z.D, z.E), line(z.Q, z.R))
  z.Ap = z.M:symmetry(z.A)
  z.w1 = tkz.midpoint(z.A, z.H)
  z.w2 = triangle(z.B, z.E, z.M).circumcenter
  z.w3 = triangle(z.C, z.D, z.M).circumcenter
\end{luacode}

\begin{tikzpicture}
  \tkzGetNodes

  \tkzMarkRightAngles[size=.2](B,E,C B,D,C)
  \tkzMarkRightAngle[green!70!black, size=.25](A,X,H)

  \tkzDrawPolygon[lines](A,B,C)
  \tkzDrawPolySeg[lines, line join=bevel](B,D,E,C)
  \tkzDrawArc[lines](w,C)(B)
  \tkzDrawSegments[helplines](A,A' B,A' H,X)
  \tkzDrawSegments[helplines=red](B,X C,X)
  \tkzDrawCircle[helplines=blue](w1,A)
  \tkzDrawCircles[helplines=cyan](w2,B w3,C)
  \tkzDrawArc[helplines](w,B)(C)
  \tkzDrawLines[helplines=orange, add=0 and .5](M,D M,E)
  \tkzDrawSegments[helplines=magenta](E,X D,X)

  \tkzDrawPoints[dots](A,B,C,D,E,H)
  \tkzDrawPoints[dots=green](A',X,M)

  \tkzLabelPoints[above](A,H,X)
  \tkzLabelPoints[below](M)
  \tkzLabelPoints[left](B,E)
  \tkzLabelPoints[right](C)
  \tkzLabelPoints[above left]()
  \tkzLabelPoints[above right](D)
  \tkzLabelPoints[below left]()
  \tkzLabelPoints[below right](A')

  \tkzLabelCircle[above left, blue](w1,A)(50){$\omega$}
  \tkzLabelCircle[below left, green!70!black](w,B)(70){$\Gamma$}
\end{tikzpicture}
