\begin{luacode}
  init_elements()
  local r = 4
  z.A = point:polar_deg(r, 120)
  z.B = point:polar_deg(r, 210)
  z.C = point:polar_deg(r, 330)
  T.ABC = triangle(z.A, z.B, z.C)

  z.H = T.ABC.orthocenter
  _, z.D, z.E = T.ABC:orthic():get()
  C.BHC = triangle(z.B, z.H, z.C):circum_circle()
  z.P = C.BHC:point(0.15, z.C)
  _, z.Q, z.R = T.ABC:cevian(z.P):get()

  z.w = C.BHC.center
\end{luacode}

\begin{tikzpicture}
  \tkzGetNodes

  \tkzDrawPolygon[lines](A,B,C)
  \tkzDrawPolygon[lines](B,D,E,C,R,Q)
  \tkzDrawArc[lines](w,C)(B)

  \tkzDrawPoints[dots](A,B,C,D,E,H,P,Q,R)

  \tkzLabelPoints[above](A,H)
  \tkzLabelPoints[below](P)
  \tkzLabelPoints[left](B,E,R)
  \tkzLabelPoints[right](C)
  \tkzLabelPoints[above left]()
  \tkzLabelPoints[above right](D,Q)
  \tkzLabelPoints[below left]()
  \tkzLabelPoints[below right]()
\end{tikzpicture}
