\begin{luacode}
  init_elements()
  local r = 4
  z.A = point:polar_deg(r, 120)
  z.B = point:polar_deg(r, 155)
  z.C = point:polar_deg(r, 25)
  T.ABC = triangle(z.A, z.B, z.C)
  z.M = T.ABC.bc.mid
  L.AD = T.ABC:bisector()
  z.D = L.AD.pb
  z.P = z.A:symmetry(z.D)
  T.PBC = triangle(z.P, z.B, z.C)
  C.PBC = T.PBC:circum_circle()
  L.MQ = L.AD:ll_from(z.M)
  z.Q = intersection(C.PBC, L.MQ, {near = z.M})
  z.R = intersection(line(z.A, z.M), line(z.P, z.Q))
  z.O = C.PBC.center

  C.ABC = T.ABC:circum_circle()
  z.O1 = C.ABC.center
  z.E = intersection(C.PBC, L.AD, {known = z.P})
  z.F = intersection(C.ABC, L.AD, {known = z.A})
\end{luacode}

\begin{tikzpicture}
  \tkzGetNodes

  \tkzDrawPolygons[lines](A,B,C)
  \tkzDrawSegments[lines](P,B P,C P,D M,Q P,Q A,M)
  \tkzDrawCircle[lines](O,P)

  \tkzDrawCircle[helplines](O1,A)
  \tkzDrawSegments[helplines](D,F M,F M,E)

  \tkzDrawPoints[dots](A,B,C,D,M,P,Q,R)
  \tkzDrawPoints[dots=green](E,F)

  \tkzLabelPoints[above]()
  \tkzLabelPoints[below](Q,F)
  \tkzLabelPoints[left](A,B)
  \tkzLabelPoints[right](C,R)
  \tkzLabelPoints[above left](P)
  \tkzLabelPoints[above right](M)
  \tkzLabelPoints[below left](D,E)
  \tkzLabelPoints[below right]()
\end{tikzpicture}
