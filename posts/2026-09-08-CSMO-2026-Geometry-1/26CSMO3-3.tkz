\begin{luacode}
  init_elements()
  local r = 4
  z.A = point:polar_deg(r, 120)
  z.B = point:polar_deg(r, 155)
  z.C = point:polar_deg(r, 25)
  T.ABC = triangle(z.A, z.B, z.C)
  z.M = T.ABC.bc.mid
  L.AD = T.ABC:bisector()
  z.D = L.AD.pb
  z.P = z.A:symmetry(z.D)
  T.PBC = triangle(z.P, z.B, z.C)
  C.PBC = T.PBC:circum_circle()
  L.MQ = L.AD:ll_from(z.M)
  z.Q = intersection(C.PBC, L.MQ, {near = z.M})
  L.PQ = line(z.P, z.Q)
  z.R = intersection(line(z.A, z.M), L.PQ)
  z.O = C.PBC.center

  z.E = intersection(C.PBC, L.AD, {known = z.P})
  z.N = intersection(L.PQ, T.PBC.bc)
  L.BR = line(z.B, z.R)
  z.S = intersection(C.PBC, L.BR, {known = z.B})
  z.K = T.PBC.ca.mid
\end{luacode}

\begin{tikzpicture}
  \tkzGetNodes

  \tkzDrawPolygons[lines](A,B,C P,B,Q,C)
  \tkzDrawSegments[lines](P,D A,M P,Q M,Q R,B R,C)
  \tkzDrawCircle[lines](O,P)

  \tkzDrawSegments[helplines](R,S P,S C,S)
  \tkzDrawSegments[helplines=red](K,Q S,Q)

  \tkzDrawPoints[dots](A,B,C,D,M,P,Q,R)
  \tkzDrawPoints[dots=green](N,S)
  \tkzDrawPoints[dots=red](K)

  \tkzLabelPoints[above](K)
  \tkzLabelPoints[below](Q,N)
  \tkzLabelPoints[left](A,B)
  \tkzLabelPoints[right](C)
  \tkzLabelPoints[above left](P)
  \tkzLabelPoints[above right](M,R,S)
  \tkzLabelPoints[below left](D)
  \tkzLabelPoints[below right]()
\end{tikzpicture}
