\begin{luacode}
  init_elements()
  local r = 3.5
  z.K = point:polar_deg(r, 110)
  z.B = point:polar_deg(r, 220)
  z.C = point:polar_deg(r, 320)
  T.KBC = triangle(z.K, z.B, z.C)
  z.D = T.KBC.mb
  z.A = T.KBC.mc

  z.A, z.B, z.C, z.D = z.B, z.A, z.D, z.C

  L.BD = line(z.B, z.D)
  L.AC = line(z.A, z.C)
  z.E = intersection(L.BD, L.AC)
  C.ABE = triangle(z.A, z.B, z.E):circum_circle()
  C.CDE = triangle(z.C, z.D, z.E):circum_circle()
  z.F = intersection(C.ABE, C.CDE, {known = z.E})
  L.AG = L.BD:ll_from(z.A)
  L.EF = line(z.E, z.F)
  z.G = intersection(L.AG, L.EF)

  z.w1 = C.ABE.center
  z.w2 = C.CDE.center

  C.base = circle(z.E, z.A)
  z.Bp, z.Cp, z.Dp, z.Fp = C.base:inversion(z.B, z.C, z.D, z.F)
\end{luacode}

\begin{tikzpicture}
  \tkzGetNodes

  \tkzDrawPolygon[lines](A,B,C,D)
  \tkzDrawSegments[lines](A,G E,G A,C B,D)
  \tkzDrawCircles[lines](w1,E w2,E)

  \tkzDrawSegments[helplines](B,B')
  \tkzDrawSegments[helplines=red](A,B')

  \tkzDrawPoints[dots](A,B,C,D,E,F,G)
  \tkzDrawPoints[dots=green](B')

  \tkzLabelPoints[above](B,C)
  \tkzLabelPoints[below]()
  \tkzLabelPoints[left](B')
  \tkzLabelPoints[right](E,F,G)
  \tkzLabelPoints[above left]()
  \tkzLabelPoints[above right]()
  \tkzLabelPoints[below left](A)
  \tkzLabelPoints[below right](D)
\end{tikzpicture}
